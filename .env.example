# ---------------------------------------------------------------------------
# Smart Campus Placement Portal - environment configuration
# Copy this file to ".env" and fill in real values.  NEVER commit ".env".
# ---------------------------------------------------------------------------

# Flask
FLASK_APP=run.py
FLASK_DEBUG=1
# Generate one with: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Local SQLite is the default and persists to instance/placement.db.
# Optional PostgreSQL override (Supabase direct or pooled connection string).
# DATABASE_URL=postgresql+psycopg://postgres:password@db.example.supabase.co:5432/postgres

# Uploads
MAX_RESUME_SIZE_MB=5

# Sessions
SESSION_LIFETIME_MINUTES=120

# Optional private Supabase Storage. Create this bucket as PRIVATE first.
# All three values are required to enable remote resume storage.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=server-only-secret
# SUPABASE_RESUME_BUCKET=student-resumes
SUPABASE_SIGNED_URL_TTL=300
